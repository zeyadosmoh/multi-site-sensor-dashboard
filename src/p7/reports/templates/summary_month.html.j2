{% extends "_base.html.j2" %}
{% block title %}{{ t("pdf_summary_title") }} {{ f.month }}{% endblock %}
{% block body %}
{% set k = f.kpis %}
<h1>{{ t("pdf_summary_title") }}</h1>
<p class="sub">{{ month_label }} · {{ n(k.sites) }} {{ t.plural("sites_lower", k.sites) }} · {{ t("pdf_generated") }} {{ n(f.generated_at) }}</p>
<div class="banner">{{ t("synthetic_banner") }}</div>

<p>{% for s in ["red", "amber", "green"] %}<span class="status {{ s }}">{{ t("status_" ~ s) }}: {{ n(f.status_counts[s] | string) }}</span> {% endfor %}</p>

<h2>{{ t("pdf_key_figures") }}</h2>
<div class="kv">
<table>
  <tr><td>{{ t("completeness") }}</td><td>{{ n(k.completeness_pct ~ "%") }}</td></tr>
  <tr><td>{{ t("readings_received") }}</td><td>{{ nr(k.readings, k.expected_readings, 0, "/") }}</td></tr>
  <tr><td>{{ t("unreliable_readings") }}</td><td>{{ n(k.unreliable_readings) }}</td></tr>
  <tr><td>{{ t("stuck_runs") }}</td><td>{{ n(k.stuck_runs) }}</td></tr>
</table>
<table>
  <tr><td>{{ t("avg_temp") }}</td><td>{{ n(k.temp_avg ~ " °C") }}</td></tr>
  <tr><td>{{ t("temp_range") }}</td><td>{{ n(k.temp_min ~ " – " ~ k.temp_max ~ " °C") }}</td></tr>
  <tr><td>{{ t("avg_hum") }}</td><td>{{ n(k.hum_avg ~ " %") }}</td></tr>
  <tr><td>{{ t("time_out_of_range") }}</td><td>{{ n(k.oor_hours) }} {{ t.plural("unit_h", k.oor_hours) }} · {{ n(k.oor_events) }} {{ t.plural("events_lower", k.oor_events) }}</td></tr>
</table>
</div>
{% if k.unreliable_readings != "0" %}<p class="note warn">{{ t("unreliable_note") }}</p>{% endif %}

<h2>{{ t("pdf_sites_table") }}</h2>
<table>
  <tr><th>{{ t("site") }}</th><th class="r">{{ t("completeness") }}</th><th class="r">{{ t("unreliable_short") }}</th>
      <th class="r">{{ t("avg_temp") }}</th><th class="r">{{ t("min_max_temp") }}</th><th class="r">{{ t("avg_hum") }}</th>
      <th class="r">{{ t("time_out_of_range") }}</th><th class="r">{{ t("oor_events") }}</th></tr>
  {% for s in f.sites %}
  <tr><td><span class="dot {{ s.status }}"></span><span class="num" dir="ltr">{{ s.code }}</span> {{ loc(s, "city") }}</td>
      <td class="r">{{ n(s.completeness_pct ~ "%") }}</td><td class="r">{{ n(s.unreliable_readings) }}</td>
      <td class="r">{{ n(s.temp_avg) }}</td><td class="r">{{ n(s.temp_min ~ " – " ~ s.temp_max) }}</td>
      <td class="r">{{ n(s.hum_avg) }}</td><td class="r">{{ n(s.oor_hours) }}</td><td class="r">{{ n(s.oor_events) }}</td></tr>
  {% endfor %}
</table>
<p class="muted small">{{ t("pdf_units_note") }}</p>

<section class="fig">
<h2>{{ t("chart_site_compare") }}</h2>
<div class="chart">{{ charts.sites | safe }}</div>
<p class="legend">{{ t("pdf_legend_sites") }}</p>
</section>

<h2>{{ t("pdf_longest_events") }}</h2>
{% if f.events %}
<table>
  <tr><th>{{ t("site") }}</th><th>{{ t("start") }}</th><th>{{ t("end") }}</th><th class="r">{{ t("duration_h") }}</th><th>{{ t("what") }}</th>
      <th class="r">{{ t("max_temp") }}</th><th class="r">{{ t("max_hum") }}</th></tr>
  {% for e in f.events %}
  <tr><td><span class="num" dir="ltr">{{ e.site }}</span></td><td>{{ n(e.start) }}</td><td>{{ n(e.end) }}</td><td class="r">{{ n(e.hours) }}</td>
      <td>{{ t("event_" ~ e.kind) }}</td><td class="r">{{ n(e.max_temperature) }}</td><td class="r">{{ n(e.max_humidity) }}</td></tr>
  {% endfor %}
</table>
{% else %}<p class="muted">{{ t("none") }}</p>{% endif %}

<h2>{{ t("stuck_sensor_periods") }}</h2>
{% if f.stuck_runs %}
<table>
  <tr><th>{{ t("site") }}</th><th>{{ t("start") }}</th><th>{{ t("end") }}</th><th class="r">{{ t("readings") }}</th><th class="r">{{ t("repeated_value") }}</th></tr>
  {% for s in f.stuck_runs %}
  <tr><td><span class="num" dir="ltr">{{ s.site }}</span></td><td>{{ n(s.start) }}</td><td>{{ n(s.end) }}</td><td class="r">{{ n(s.readings) }}</td>
      <td class="r">{{ n(s.temperature ~ " °C / " ~ s.humidity ~ " %") }}</td></tr>
  {% endfor %}
</table>
{% else %}<p class="muted">{{ t("none") }}</p>{% endif %}

<h2>{{ t("pdf_data_sources") }}</h2>
{% set rej = f.uploads | selectattr("rejected", "ne", "0") | list %}
<p>{{ t("pdf_files_loaded", n=n(f.uploads | length | string)) }}</p>
{% if rej %}
<table>
  <tr><th>{{ t("file") }}</th><th class="r">{{ t("rows_rejected") }}</th><th>{{ t("reasons") }}</th></tr>
  {% for u in rej %}
  <tr><td><span class="num" dir="ltr">{{ u.filename }}</span></td><td class="r">{{ n(u.rejected) }}</td>
      <td>{% for r, c in u.reasons.items() %}{{ t("reject_" ~ r) }} {{ n(c | string) }}{% if not loop.last %}{{ t("list_sep") }}{% endif %}{% endfor %}</td></tr>
  {% endfor %}
</table>
{% endif %}
<p class="muted small">{{ t("pdf_definitions") }}</p>
{% endblock %}
