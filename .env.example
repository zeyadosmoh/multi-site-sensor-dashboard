# Copy to .env with `python -m p7 setup-env` (fills random secrets). Never commit .env.

# PostgreSQL 16 (docker container p7-sensors-pg), bound to 127.0.0.1
POSTGRES_USER=p7
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p7
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5437

# Web app, bound to 127.0.0.1
APP_HOST=127.0.0.1
APP_PORT=8790
# Signs the session cookie. Long random string.
SESSION_SECRET=change-me
# Set true only behind HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# First admin account, created by `python -m p7 create-admin` (or on first Docker start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Synthetic data generator
DATA_DIR=data
GEN_SEED=7

# Reports and upload limits
REPORTS_DIR=reports
MAX_UPLOAD_MB=50
